# Copy to .env for local settings. Never commit the populated .env.
# Exported environment variables override .env; saved desktop settings override
# the desktop's initial connection defaults.
SYNC_SERVER_URL=http://127.0.0.1:8766
ROKU_URL=http://192.168.1.100:8060
# Set your own strong room token before running the relay or bridge:
# SYNC_TOKEN=

# Optional local reference notes. Discovery reads these from the Roku itself;
# these notes do not override device responses or the public test fixtures.
LOCAL_DEVICE_SERIAL=
LOCAL_DEVICE_UUID=
LOCAL_WIFI_SSID=
